<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="App_Desktop.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFCFAF7" />
            <SolidColorBrush x:Key="CardBorderBrush" Color="#24181715" />
            <CornerRadius x:Key="PanelCornerRadius">8</CornerRadius>
            <Thickness x:Key="PanelPadding">18</Thickness>

            <Style x:Key="SectionTitleTextBlockStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="22" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextWrapping" Value="WrapWholeWords" />
            </Style>

            <Style x:Key="MutedTextBlockStyle" TargetType="TextBlock">
                <Setter Property="TextWrapping" Value="WrapWholeWords" />
                <Setter Property="Opacity" Value="0.72" />
            </Style>

            <Style x:Key="CardBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource PanelCornerRadius}" />
                <Setter Property="Padding" Value="{StaticResource PanelPadding}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
