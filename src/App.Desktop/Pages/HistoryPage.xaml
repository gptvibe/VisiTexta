<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="App_Desktop.Pages.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="28" ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Spacing="14">
            <StackPanel Spacing="4">
                <TextBlock Text="History" Style="{StaticResource SectionTitleTextBlockStyle}" />
                <TextBlock Text="Local OCR job records. Source files and outputs stay where you chose them." Style="{StaticResource MutedTextBlockStyle}" />
            </StackPanel>
            <ScrollViewer>
                <StackPanel x:Name="HistoryStackPanel" Spacing="10" />
            </ScrollViewer>
        </StackPanel>

        <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Spacing="4">
                    <TextBlock x:Name="TitleTextBlock" Text="Select a job" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock x:Name="MetaTextBlock" Text="OCR history appears here." Style="{StaticResource MutedTextBlockStyle}" />
                </StackPanel>

                <TextBox
                    x:Name="ResultTextBox"
                    Grid.Row="1"
                    AcceptsReturn="True"
                    TextWrapping="Wrap"
                    IsReadOnly="True"
                    PlaceholderText="No history item selected." />

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <Button Content="Open Result" Click="OpenResult_Click" />
                    <Button Content="Open Folder" Click="OpenFolder_Click" />
                    <Button Content="Retry" Click="Retry_Click" />
                    <Button Content="Delete" Click="Delete_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
