<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="App_Desktop.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="28" Spacing="16">
            <StackPanel Spacing="4">
                <TextBlock Text="Settings" Style="{StaticResource SectionTitleTextBlockStyle}" />
                <TextBlock Text="Native Windows preferences, storage paths, runtime profile, and local-first defaults." Style="{StaticResource MutedTextBlockStyle}" />
            </StackPanel>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Defaults" FontWeight="SemiBold" />
                    <Grid ColumnSpacing="12" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="260" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="ThemeComboBox" Header="Theme" />
                        <ComboBox x:Name="RuntimeComboBox" Grid.Column="1" Header="Runtime profile" />
                        <ComboBox x:Name="ModeComboBox" Grid.Column="2" Header="Default OCR mode" />
                    </Grid>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="260" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="ExportFormatComboBox" Header="Default export" />
                        <NumberBox x:Name="DpiNumberBox" Grid.Column="1" Header="Default DPI" Minimum="120" Maximum="600" />
                        <NumberBox x:Name="MaxDimensionNumberBox" Grid.Column="2" Header="Max OCR dimension" Minimum="800" Maximum="3200" />
                    </Grid>
                    <CheckBox x:Name="IdlePrewarmCheckBox" Content="Idle prewarm when a persistent local runtime is available" />
                    <Button Content="Save settings" Click="Save_Click" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Storage" FontWeight="SemiBold" />
                    <TextBlock x:Name="StorageModeTextBlock" Style="{StaticResource MutedTextBlockStyle}" />
                    <TextBox x:Name="PathsTextBox" AcceptsReturn="True" IsReadOnly="True" TextWrapping="NoWrap" FontFamily="Consolas" MinHeight="190" />
                    <TextBlock Text="Portable mode is selected when portable-data or visitexta-portable.txt exists beside VisiTexta.exe." Style="{StaticResource MutedTextBlockStyle}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Privacy" FontWeight="SemiBold" />
                    <TextBlock Text="OCR, PDF rendering, document processing, history, settings, and exports are local. The network is used only when you download model files." Style="{StaticResource MutedTextBlockStyle}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
