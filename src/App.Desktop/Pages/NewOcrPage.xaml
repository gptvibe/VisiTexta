<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="App_Desktop.Pages.NewOcrPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Padding="28">
        <Grid RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock Text="OCR workspace" Style="{StaticResource SectionTitleTextBlockStyle}" />
            <TextBlock Text="Run OCR on the right while recent transcripts stay in the left sidebar for quick reopening." Style="{StaticResource MutedTextBlockStyle}" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="410" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer>
                <StackPanel Spacing="14">
                    <Border
                        x:Name="DropZone"
                        AllowDrop="True"
                        DragOver="DropZone_DragOver"
                        Drop="DropZone_Drop"
                        MinHeight="180"
                        Style="{StaticResource CardBorderStyle}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                            <FontIcon Glyph="&#xE898;" FontSize="34" />
                            <TextBlock Text="Run OCR" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock Text="Drop PNG, JPG, JPEG, or PDF here, or browse for a file to start a new transcript." TextAlignment="Center" Style="{StaticResource MutedTextBlockStyle}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                                <Button Content="Browse file" Click="BrowseFile_Click" HorizontalAlignment="Center" />
                                <Button x:Name="StartButton" Content="Run OCR" Click="Start_Click" IsEnabled="False" />
                                <Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click" IsEnabled="False" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Source" FontWeight="SemiBold" />
                            <TextBox x:Name="SourceTextBox" PlaceholderText="No file selected" IsReadOnly="True" />
                            <ComboBox x:Name="WorkflowComboBox" Header="Mode" SelectionChanged="WorkflowComboBox_SelectionChanged" />
                            <ComboBox x:Name="ExtractTemplateComboBox" Header="Extract preset" />
                            <TextBox x:Name="PromptTextBox" Header="Optional override" PlaceholderText="Leave blank for the selected mode default." AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Model and Runtime" FontWeight="SemiBold" />
                            <ComboBox x:Name="ModelComboBox" Header="OCR model" DisplayMemberPath="Label" />
                            <ComboBox x:Name="RuntimeComboBox" Header="Runtime profile" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <NumberBox x:Name="DpiNumberBox" Header="DPI" Value="300" Minimum="120" Maximum="600" SmallChange="20" />
                                <NumberBox x:Name="MaxDimensionNumberBox" Grid.Column="1" Header="Max px" Value="1600" Minimum="800" Maximum="3200" SmallChange="100" Width="126" />
                            </Grid>
                            <CheckBox x:Name="StudyBoostCheckBox" Content="Study Boost for Notes mode" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="OCR Output" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock x:Name="OutputMetaTextBlock" Text="Markdown will stream here." Style="{StaticResource MutedTextBlockStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button x:Name="OpenOutputButton" Content="Open Result" Click="OpenOutput_Click" IsEnabled="False" />
                            <Button Content="Copy" Click="Copy_Click" />
                        </StackPanel>
                    </Grid>

                    <TextBox
                        x:Name="OutputTextBox"
                        Grid.Row="1"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        PlaceholderText="Local OCR output appears here."
                        VerticalAlignment="Stretch"
                        HorizontalAlignment="Stretch" />
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="14">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusTextBlock" Text="Ready" FontWeight="SemiBold" VerticalAlignment="Center" />
                <ProgressBar x:Name="ProgressBar" Grid.Column="1" Minimum="0" Maximum="100" Value="0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="Local-first. No cloud OCR." Style="{StaticResource MutedTextBlockStyle}" VerticalAlignment="Center" />
            </Grid>
        </Border>
        </Grid>
    </Border>
</Page>
